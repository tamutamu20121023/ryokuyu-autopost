# AIプロバイダ: auto / gemini / openai / none
# auto = GEMINI_API_KEY があればGemini、なければ OPENAI_API_KEY、どちらもなければテンプレート
AI_PROVIDER=auto

# --- Google Gemini ---
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 高負荷（503）やタイムアウト時に順番に試すモデル
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# 1モデルあたりのタイムアウト（ミリ秒）
AI_TIMEOUT_MS=45000

# --- OpenAI または OpenAI互換API（LM Studio / Ollama など）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
